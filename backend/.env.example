PORT=3000
FRONTEND_URL=http://localhost:5173

# Clave privada usada para firmar y verificar tokens JWT. Reemplazar por una clave segura.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h

# Conexión MySQL (usar DB_SSL=true para conexiones que requieran SSL, como Aiven).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=veterinariaDB
DB_SSL=false
