PORT=3000
# En producción, reemplazar por el origen público del frontend; se aceptan varios separados por coma.
FRONTEND_URL=http://localhost:5173
# URL pública base de esta API para Swagger, sin el sufijo /api. En Vercel se detecta automáticamente.
# API_BASE_URL=https://tu-backend.vercel.app

# Clave privada usada para firmar y verificar tokens JWT. Reemplazar por una clave segura.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h

# Conexión MySQL (usar DB_SSL=true para conexiones que requieran SSL, como Aiven).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=veterinariaDB
DB_SSL=false
